# mock | live — mock runs entirely on local fixtures, live hits the real NUVO backend
EXPO_PUBLIC_API_MODE=mock

# Only used when EXPO_PUBLIC_API_MODE=live
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Google Sign-In — OAuth 2.0 Client IDs from Google Cloud Console (Credentials page).
# Only used when EXPO_PUBLIC_API_MODE=live; unused ones can stay blank.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
